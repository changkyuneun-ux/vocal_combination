{
  "name": "rights-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "pretest": "npm run build --prefix ../vcrl",
    "test": "node --test --test-concurrency=4 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
