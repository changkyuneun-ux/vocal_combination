    "scenario": "node src/scenario/main.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "pg-boss": "^12.35.0",
    "vcrl": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.9.0"
  }
}
